# Data: raw and intermediate files are large, regenerable, and (for gaitpdb/PADS) PhysioNet's
# license requires separate attribution rather than redistribution — see data-README.md instead
# of committing raw data. data/processed/*.csv IS tracked: these are small, reproducible
# results/feature tables meant to ship with the repo (same as features.csv/features_v2.csv).
data/raw/
data/raw_sorted/
data/raw_pads/
data/raw_voice/
data/interim/

# Keep the folder structure visible in git even though raw/interim contents are ignored
!data/raw/.gitkeep
!data/raw_sorted/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Python
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Editor/OS cruft
.vscode/
*.swp

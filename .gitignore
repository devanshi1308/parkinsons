# Data (large, regenerable, and PhysioNet's license requires separate attribution
# rather than redistribution — see data/README.md instead of committing raw data)
data/raw/
data/raw_sorted/
data/interim/
data/processed/*.csv

# Keep the folder structure visible in git even though contents are ignored
!data/raw/.gitkeep
!data/raw_sorted/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Python
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Editor/OS cruft
.vscode/
*.swp

data/raw_pads/
data/raw_voice/
!data/processed/leakage_comparison.csv
!data/processed/leakage_audit.csv
